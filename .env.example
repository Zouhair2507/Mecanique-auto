# Port d'écoute du serveur
PORT=3000

# Mot de passe de l'espace administration (/admin).
# Si absent, un mot de passe est généré au premier démarrage et affiché dans la console.
# Vous pouvez aussi le changer avec : npm run set-password
ADMIN_PASSWORD=

# Dossier où sont enregistrés les rendez-vous, demandes de support et réglages
DATA_DIR=./data

# Fuseau horaire du garage (pour les créneaux et le statut « ouvert / fermé »)
GARAGE_TIMEZONE=Europe/Paris

# Mettre à 1 si le site est derrière un reverse proxy (Nginx, Render, Railway...)
TRUST_PROXY=0
